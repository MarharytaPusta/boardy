<Window x:Class="Boardy.WPF.Home.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boardy - Головне меню" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#9EA6FC">

    <Grid>
        <Button Content="{Binding AdminButtonText}" 
            Command="{Binding AdminActionCommand}"
            HorizontalAlignment="Right" 
            VerticalAlignment="Top" 
            Margin="15" 
            Padding="15,5"
            Background="#FF8A80" 
            Foreground="White" 
            FontSize="14" 
            BorderThickness="0"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">

            <Button Content="Почати гру" 
                Background="#FF5252" 
                Foreground="White" 
                FontSize="42" 
                FontWeight="Bold"
                Padding="10,15"
                Margin="0,0,0,10"
                BorderThickness="0"/>

            <Button Content="Усі гравці" 
                Background="#FF8A80" 
                Foreground="White" 
                FontSize="28" 
                FontWeight="DemiBold"
                Padding="10,10"
                BorderThickness="0"/>

        </StackPanel>
    </Grid>
</Window>