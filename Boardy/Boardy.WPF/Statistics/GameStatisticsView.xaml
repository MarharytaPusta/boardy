<UserControl x:Class="Boardy.WPF.Statistics.GameStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#8592F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="40,28,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="32"
                       FontWeight="Medium"
                       Foreground="Black">
                <Run Text="Статистика: " />
                <Run Text="{Binding GameName}" />
            </TextBlock>

            <Button Content="Назад"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Right"
                    Width="105"
                    Height="44"
                    Background="#FF6359"
                    Foreground="White"
                    FontSize="16"
                    BorderThickness="0"
                    Cursor="Hand" />
        </Grid>

        <Border Grid.Row="1"
                Background="#FFE5E5"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,14"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#B00020"
                       FontSize="14" />
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="Зіграно партій"
                               FontSize="14"
                               Foreground="#555555" />
                    <TextBlock Text="{Binding TotalPlayedMatches}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="Black"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="Найвищий результат"
                               FontSize="14"
                               Foreground="#555555" />
                    <TextBlock Text="{Binding HighestScoreDisplay}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="Black"
                               TextWrapping="Wrap"
                               Margin="0,4,0,4" />
                    <TextBlock Text="{Binding TopResultsSummary}"
                               FontSize="13"
                               Foreground="#666666"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="20,10"
                Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Сортувати за"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          Width="220"
                          Height="30"
                          FontSize="14"
                          VerticalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Background="White"
                CornerRadius="10"
                Padding="20,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="№" FontSize="15" Foreground="Black" />
                <TextBlock Grid.Column="1" Text="Ім'я" FontSize="15" Foreground="Black" />
                <TextBlock Grid.Column="2" Text="Партії" FontSize="15" Foreground="Black" />
                <TextBlock Grid.Column="3" Text="Перемоги" FontSize="15" Foreground="Black" />
                <TextBlock Grid.Column="4" Text="Макс. балів" FontSize="15" Foreground="Black" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Players}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#B4BEFA"
                                CornerRadius="10"
                                Padding="20,14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="16" Foreground="Black" />
                                <TextBlock Grid.Column="1" Text="{Binding PlayerName}" FontSize="16" Foreground="Black" />
                                <TextBlock Grid.Column="2" Text="{Binding MatchesPlayed}" FontSize="16" Foreground="Black" />
                                <TextBlock Grid.Column="3" Text="{Binding WinsCount}" FontSize="16" Foreground="Black" />
                                <TextBlock Grid.Column="4" Text="{Binding BestScore}" FontSize="16" Foreground="Black" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>