<UserControl x:Class="Boardy.WPF.Statistics.PlayerStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Статистика гравця"
                       FontSize="42"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button Content="Назад"
                    Command="{Binding GoBackCommand}"
                    Background="#FF5E5E"
                    Foreground="White"
                    FontSize="20"
                    Padding="20,8"
                    BorderThickness="0"
                    HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="6"
                Padding="20,12"
                Margin="0,20,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding PlayerName}"
                           FontSize="24"
                           FontWeight="DemiBold"
                           Foreground="Black"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Ігри" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding PlayedGamesCount}" FontSize="22" Foreground="Black" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Партії" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding PlayedMatchesCount}" FontSize="22" Foreground="Black" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Перемоги" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding WinsCount}" FontSize="22" Foreground="Black" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="#FF5E5E"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="6"
                Padding="20,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16"
                             Padding="10,5"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CCCCCC"
                             BorderThickness="1"/>
                    <TextBlock Text="Пошук за назвою гри..."
                               FontSize="16"
                               Foreground="#888888"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Сортувати за"
                               FontSize="16"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              Width="210"
                              Height="34"
                              FontSize="15"
                              VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="White"
                CornerRadius="6"
                Padding="20,12"
                Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Гра" FontSize="18" Foreground="Black"/>
                <TextBlock Grid.Column="1" Text="Партії" FontSize="18" Foreground="Black"/>
                <TextBlock Grid.Column="2" Text="Перемоги" FontSize="18" Foreground="Black"/>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="GamesList" ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#C8CAFF"
                                    CornerRadius="6"
                                    Margin="0,5"
                                    Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding GameName}" FontSize="20" Foreground="Black"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PlayedMatchesCount}" FontSize="20" Foreground="Black"/>
                                    <TextBlock Grid.Column="2" Text="{Binding WinsCount}" FontSize="20" Foreground="Black"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding EmptyStateMessage}"
                       FontSize="22"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,30,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=GamesList}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>