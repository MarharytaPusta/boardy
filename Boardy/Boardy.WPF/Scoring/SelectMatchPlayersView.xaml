<UserControl x:Class="Boardy.WPF.Scoring.SelectMatchPlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Button Content="Додати гравця"
                    Command="{Binding NavigateToCreatePlayerCommand}"
                    Background="#FF8A80" Foreground="White"
                    FontSize="20" FontWeight="DemiBold"
                    Padding="15,8" BorderThickness="0"
                    HorizontalAlignment="Left"/>

            <TextBlock Text="Хто гратиме?"
                       FontSize="42" Foreground="Black"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Button Content="Назад"
                    Command="{Binding GoBackCommand}"
                    Background="#FF5E5E" Foreground="White"
                    FontSize="20" Padding="20,8"
                    BorderThickness="0" HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Margin="0,20,0,10" HorizontalAlignment="Stretch" MinHeight="40">
            <StackPanel Orientation="Horizontal" Margin="20,8">
                <TextBlock Text="Сортувати за" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="120" FontSize="16"
                          SelectedIndex="{Binding SortIndex}"
                          Background="#C8CAFF" BorderThickness="0" Padding="5">
                    <ComboBoxItem Content="Оберіть"/>
                    <ComboBoxItem Content="Ім'я"/>
                    <ComboBoxItem Content="Номер"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="20,12" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Номер" FontSize="20" Foreground="Black"/>
                <TextBlock Grid.Column="1" Text="Ім'я" FontSize="20" Foreground="Black"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="#FF5E5E" FontSize="16" HorizontalAlignment="Center"/>

        <Grid Grid.Row="3">
                <ListBox ItemsSource="{Binding Players}" 
                         SelectionMode="Multiple"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         Margin="0,0,0,80">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Bd" Background="#C8CAFF" CornerRadius="6" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Number}" FontSize="22" Foreground="Black"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="22" Foreground="Black"/>
                                    <TextBlock Grid.Column="2" Text="⋮" FontSize="28" Foreground="White" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E4E4FF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            <Button Content="Почати гру"
                    Command="{Binding NextStepCommand}"
                    Background="#FF5E5E" Foreground="White"
                    FontSize="24" FontWeight="DemiBold"
                    Padding="40,10" BorderThickness="0"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</UserControl>