<UserControl x:Class="Boardy.WPF.Scoring.MatchResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding GameName}"
                           FontSize="42"
                           Foreground="Black"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Результати партії"
                           FontSize="20"
                           Foreground="#45456B"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            <Button Content="Назад"
                    Command="{Binding GoBackCommand}"
                    Background="#FF5E5E"
                    Foreground="White"
                    FontSize="20"
                    Padding="20,8"
                    BorderThickness="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding MatchDate, StringFormat='Дата: {0}'}"
                       FontSize="18"
                       Foreground="Black"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding MatchStatus, StringFormat='Статус: {0}'}"
                       FontSize="18"
                       Foreground="Black"
                       HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFF0F0"
                BorderBrush="#FF5E5E"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,6"
                Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#CC3333"
                       FontSize="16"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="20,12" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Гравець" FontSize="20" Foreground="Black"/>
                <TextBlock Grid.Column="1" Text="Підсумок" FontSize="20" Foreground="Black"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <ListBox ItemsSource="{Binding Participants}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     Margin="0,0,0,80">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,5"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#C8CAFF" CornerRadius="6" Padding="20,12">
                            <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PlayerName}" FontSize="22" Foreground="Black"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalScoreText}"
                                               FontSize="22" Foreground="Black" HorizontalAlignment="Right"/>
                                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Criteria}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="180"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" Foreground="Black" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding DataContext.CanSaveResults, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             FontSize="18" Foreground="Black" Background="White" BorderThickness="0"
                                                             Padding="8,2" VerticalContentAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Зберегти результати"
                    Command="{Binding SaveResultsCommand}"
                    IsEnabled="{Binding CanSaveResults}"
                    Background="#FF5E5E"
                    Foreground="White"
                    FontSize="24"
                    FontWeight="DemiBold"
                    Padding="40,10"
                    BorderThickness="0"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</UserControl>
