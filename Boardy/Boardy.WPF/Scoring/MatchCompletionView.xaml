<UserControl x:Class="Boardy.WPF.Scoring.MatchCompletionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">

    <Grid Margin="35">
        <Button Content="На головну"
                Command="{Binding GoHomeCommand}"
                Background="#FF5E5E"
                Foreground="White"
                FontSize="20"
                Padding="20,8"
                BorderThickness="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Партію завершено"
                       FontSize="42"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>
            <TextBlock Text="{Binding WinnerTitle}"
                       FontSize="24"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <TextBlock Text="{Binding WinnerNames}"
                       FontSize="36"
                       FontWeight="DemiBold"
                       Foreground="Black"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="700"/>
        </StackPanel>
    </Grid>
</UserControl>
