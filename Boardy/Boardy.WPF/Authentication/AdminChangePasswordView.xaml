<UserControl x:Class="Boardy.WPF.Authentication.AdminChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">
    <Grid>
        <Button Content="Назад"
            Command="{Binding GoBackCommand}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="20"
            Background="#FF5959"
            Foreground="White"
            Padding="15,8"
            FontSize="16"
            BorderThickness="0"
            Cursor="Hand" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Зміна пароля адміністратора"
                       TextAlignment="Center"
                       FontSize="28"
                       Foreground="Black"
                       Margin="0,0,0,16" />
            <Border Background="#C4C5FF" Padding="28" MinWidth="420" CornerRadius="2">
                <StackPanel>
                    <TextBlock Text="Поточний пароль" FontSize="16" />
                    <PasswordBox x:Name="CurrentPasswordBox" FontSize="16" Padding="4" Margin="0,4,0,10" />
                    <TextBlock Text="Новий пароль" FontSize="16" />
                    <PasswordBox x:Name="NewPasswordBox" FontSize="16" Padding="4" Margin="0,4,0,10" />
                    <TextBlock Text="Повторіть новий пароль" FontSize="16" />
                    <PasswordBox x:Name="ConfirmPasswordBox" FontSize="16" Padding="4" Margin="0,4,0,8" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D32F2F"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#227A32"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                    <Button Content="Змінити пароль"
                            Command="{Binding ChangePasswordCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="#FF6363"
                            Foreground="White"
                            FontSize="18"
                            Padding="0,10"
                            Width="200"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            BorderThickness="0"
                            Cursor="Hand" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
