<UserControl x:Class="Boardy.WPF.Authentication.AdminChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Зміна пароля адміністратора"
                       TextAlignment="Center"
                       FontSize="34"
                       Foreground="Black"
                       Margin="0,0,0,25" />
            <Border Background="#C4C5FF" Padding="40" MinWidth="420" CornerRadius="2">
                <StackPanel>
                    <TextBlock Text="Поточний пароль" FontSize="16" />
                    <PasswordBox x:Name="CurrentPasswordBox" FontSize="18" Padding="4" Margin="0,5,0,15" />
                    <TextBlock Text="Новий пароль" FontSize="16" />
                    <PasswordBox x:Name="NewPasswordBox" FontSize="18" Padding="4" Margin="0,5,0,15" />
                    <TextBlock Text="Повторіть новий пароль" FontSize="16" />
                    <PasswordBox x:Name="ConfirmPasswordBox" FontSize="18" Padding="4" Margin="0,5,0,15" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" FontSize="14" TextAlignment="Center" />
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#227A32" FontSize="14" TextAlignment="Center" />
                    <Button Content="Змінити пароль"
                            Command="{Binding ChangePasswordCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="#FF6363"
                            Foreground="White"
                            FontSize="18"
                            Padding="0,10"
                            Margin="0,10,0,0"
                            BorderThickness="0"
                            Cursor="Hand" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
