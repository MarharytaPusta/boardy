<UserControl x:Class="Boardy.WPF.GameCatalog.CreateScoreTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Новий шаблон оцінювання" FontSize="42" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Content="Назад" Command="{Binding GoBackCommand}" Background="#FF5E5E" Foreground="White" FontSize="20" Padding="20,8" BorderThickness="0" HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="1" Background="#C8CAFF" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="50,40" Width="850">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="450"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Назва шаблону:" FontSize="22" Foreground="Black" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Padding="5,6" VerticalContentAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15" MaxHeight="320">
                    <ItemsControl ItemsSource="{Binding Criteria}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="270"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Уведіть критерій:" FontSize="22" Foreground="Black" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Padding="5,6" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsNegative}" Content="Від'ємний" FontSize="18" Foreground="#555" VerticalAlignment="Center">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>

                                    <Button Grid.Column="3" Content="✕" 
                                            Command="{Binding DataContext.RemoveCriterionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                            CommandParameter="{Binding}" 
                                            Background="Transparent" Foreground="#FF5E5E" FontWeight="Bold" FontSize="20" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="2" Content="+ Додати критерій оцінювання" 
                        Command="{Binding AddCriterionCommand}" 
                        Background="Transparent" Foreground="#7A7A7A" FontSize="22" BorderThickness="0" 
                        HorizontalAlignment="Center" Margin="0,10,0,30" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#FF5E5E" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0"/>

                <Button Grid.Row="3" Content="Зберегти" Command="{Binding SaveCommand}" Background="#FF5E5E" Foreground="White" FontSize="24" FontWeight="DemiBold" Padding="50,12" BorderThickness="0" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>