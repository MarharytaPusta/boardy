<UserControl x:Class="Boardy.WPF.GameCatalog.GameCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Button Content="Додати нову гру"
                    Command="{Binding NavigateToCreateGameCommand}"
                    Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"
                    Background="#FFD54F"
                    Foreground="Black"
                    FontSize="20"
                    FontWeight="DemiBold"
                    Padding="10,8"
                    BorderThickness="0"
                    HorizontalAlignment="Left"/>

            <TextBlock Text="Каталог ігор"
                       FontSize="42"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button Content="Назад"
                    Command="{Binding GoBackCommand}"
                    Background="#FF5E5E"
                    Foreground="White"
                    FontSize="20"
                    Padding="20,8"
                    BorderThickness="0"
                    HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,10" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Назва гри:"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="1"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Width="180"
                     Height="32"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     Margin="0,0,20,0"/>
            <TextBlock Grid.Column="2"
                       Text="Гравців:"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox Grid.Column="3"
                     Text="{Binding PlayersCountText, UpdateSourceTrigger=PropertyChanged}"
                     Height="32"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>
            <Button Grid.Column="4"
                    Content="Шукати"
                    Command="{Binding SearchGamesCommand}"
                    Background="#FF8A80"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="DemiBold"
                    Padding="16,5"
                    Margin="10,0,0,0"
                    BorderThickness="0"/>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="#FF5E5E"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="3" Background="#C8CAFF" CornerRadius="6" Padding="20,12" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Номер" FontSize="20" Foreground="Black"/>
                <TextBlock Grid.Column="1" Text="Назва" FontSize="20" Foreground="Black"/>
                <TextBlock Grid.Column="2" Text="Кількість гравців" FontSize="20" Foreground="Black"/>
                <TextBlock Grid.Column="3" Text="Стан" FontSize="20" Foreground="Black"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#C8CAFF" CornerRadius="6" Margin="0,5" Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Number}" FontSize="22" Foreground="Black"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="22" Foreground="Black"/>
                                <TextBlock Grid.Column="2" Text="{Binding PlayersCount}" FontSize="22" Foreground="Black"/>
                                <CheckBox Grid.Column="3"
                                          IsChecked="{Binding IsActive}"
                                          IsEnabled="False"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
