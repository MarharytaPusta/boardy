<UserControl x:Class="Boardy.WPF.GameCatalog.GameCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Button Content="Додати нову гру"
                        Command="{Binding NavigateToCreateGameCommand}"
                        Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"
                    Background="#FF8A80"
                    Foreground="White"
                    FontSize="20"
                    FontWeight="DemiBold"
                    Padding="10,8"
                    BorderThickness="0"
                    HorizontalAlignment="Left"/>

                <TextBlock Text="Каталог ігор"
                       FontSize="42"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <Button Content="Назад"
                    Command="{Binding GoBackCommand}"
                    Background="#FF5E5E"
                    Foreground="White"
                    FontSize="20"
                    Padding="20,8"
                    BorderThickness="0"
                    HorizontalAlignment="Right"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Назва гри:"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
                <TextBox Grid.Column="1"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Width="180"
                     Height="32"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     Margin="0,0,20,0"/>
                <TextBlock Grid.Column="2"
                       Text="Гравців:"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
                <TextBox Grid.Column="3"
                     Text="{Binding PlayersCountText, UpdateSourceTrigger=PropertyChanged}"
                     Height="32"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>
                <Button Grid.Column="4"
                    Content="Шукати"
                    Command="{Binding LoadGamesCommand}"
                    Background="#FF8A80"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="DemiBold"
                    Padding="16,5"
                    Margin="10,0,0,0"
                    BorderThickness="0"/>
                <Button Grid.Column="5"
                    Content="Очистити"
                    Command="{Binding ClearFiltersCommand}"
                    Background="Transparent"
                    Foreground="#333333"
                    FontSize="16"
                    FontWeight="DemiBold"
                    Padding="16,5"
                    Margin="5,0,0,0"
                    BorderThickness="0"/>
            </Grid>

            <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="#FF5E5E"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

            <Border Grid.Row="3" Background="#C8CAFF" CornerRadius="6" Padding="20,12" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Номер" FontSize="20" Foreground="Black"/>
                    <TextBlock Grid.Column="1" Text="Назва" FontSize="20" Foreground="Black"/>
                    <TextBlock Grid.Column="2" Text="Кількість гравців" FontSize="20" Foreground="Black"/>
                    <TextBlock Grid.Column="3" 
                       Text="Стан" 
                       FontSize="20" 
                       Foreground="Black"
                       Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="GamesList" ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#C8CAFF" CornerRadius="6" Margin="0,5" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Number}" FontSize="22" Foreground="Black"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="22" Foreground="Black"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PlayersCount}" FontSize="22" Foreground="Black"/>
                                    <CheckBox Grid.Column="3" 
                                      IsChecked="{Binding IsActive, Mode=OneWay}" 
                                      Visibility="{Binding DataContext.IsAdminMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding DataContext.ToggleGameStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>

                                    <Menu Grid.Column="4" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <MenuItem Header="⋮"
                                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Foreground="White"
                                                  FontSize="28"
                                                  Padding="0"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                            <MenuItem Header="Переглянути деталі"
                                                      Command="{Binding Tag.ViewGameDetailsCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                      CommandParameter="{Binding}"
                                                      Foreground="Black" FontSize="16" FontWeight="DemiBold" MinWidth="200" Padding="10,6"/>
                                            <MenuItem Header="Переглянути шаблони"
                                                      Command="{Binding Tag.ViewGameTemplatesCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                      CommandParameter="{Binding}"
                                                      Foreground="Black" FontSize="16" FontWeight="DemiBold" MinWidth="200" Padding="10,6"/>
                                            <MenuItem Header="Видалити"
                                                      Command="{Binding Tag.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                            <MenuItem Header="Редагувати деталі"
                                                      Command="{Binding Tag.EditGameCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding Tag.IsAdminMode, RelativeSource={RelativeSource AncestorType=MenuItem}, Converter={StaticResource BoolToVis}}"
                                                      Foreground="Black" FontSize="16" FontWeight="DemiBold" MinWidth="200" Padding="10,6"/>
                                        </MenuItem>
                                    </Menu>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="4" Text="Ігор не знайдено" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" FontSize="22" Foreground="Black" Panel.ZIndex="1">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=GamesList}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasItems, ElementName=GamesList}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Background="#66000000" Panel.ZIndex="10" Visibility="{Binding IsDetailsPopupOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFE0" 
                    MinWidth="400" 
                    MaxWidth="800"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Padding="30">
                <StackPanel Margin="0">
                    <TextBlock Text="{Binding PopupGameName}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding PopupGameDescription}" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>
                    <TextBlock Text="{Binding PopupGamePlayers, StringFormat='Кількість гравців: {0}'}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <Button Content="Закрити" Command="{Binding ClosePopupCommand}" Background="#FF5E5E" Foreground="White" FontSize="18" Padding="30,10" BorderThickness="0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="#66000000" Panel.ZIndex="10" Visibility="{Binding IsTemplatesPopupOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFE0" 
                    MinWidth="450" 
                    MaxWidth="900"
                    MaxHeight="650"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Padding="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Шаблони оцінювання" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,25">

                        <ItemsControl ItemsSource="{Binding PopupTemplates}" HorizontalAlignment="Center">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="340" Background="#C4C5FF" Margin="10" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TemplateName}" FontSize="20" FontWeight="DemiBold" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                            <ItemsControl ItemsSource="{Binding Criteria}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name, StringFormat='{}{0}:'}" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                                            <Border Grid.Column="1" Background="White" BorderBrush="#CCC" BorderThickness="1" Height="28"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Закрити" Command="{Binding ClosePopupCommand}" Background="#FF5E5E" Foreground="White" FontSize="18" Padding="30,10" BorderThickness="0" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>