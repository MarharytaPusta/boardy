<UserControl x:Class="Boardy.WPF.GameCatalog.GameCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Button Content="Додати нову гру"
                        Command="{Binding NavigateToCreateGameCommand}"
                        Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"
                        Background="#FF8A80"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="DemiBold"
                        Padding="10,8"
                        BorderThickness="0"
                        HorizontalAlignment="Left"/>

                <TextBlock Text="Каталог ігор"
                           FontSize="42"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Button Content="Назад"
                        Command="{Binding GoBackCommand}"
                        Background="#FF5E5E"
                        Foreground="White"
                        FontSize="20"
                        Padding="20,8"
                        BorderThickness="0"
                        HorizontalAlignment="Right"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Назва гри:" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="32" FontSize="16" VerticalContentAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="2" Text="Гравців:" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" Text="{Binding PlayersCountText, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="16" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="4" Text="Сортувати за:" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="5"
                          Width="205"
                          Height="32"
                          FontSize="16"
                          SelectedIndex="{Binding SortIndex}"
                          VerticalContentAlignment="Center"
                          Margin="0,0,15,0">
                    <ComboBoxItem Content="За замовчуванням"/>
                    <ComboBoxItem Content="Назвою"/>
                    <ComboBoxItem Content="Зіграно (більше → менше)"/>
                    <ComboBoxItem Content="Зіграно (менше → більше)"/>
                </ComboBox>

                <Button Grid.Column="6" Content="Шукати" Command="{Binding LoadGamesCommand}" Background="#FF8A80" Foreground="White" FontSize="16" FontWeight="DemiBold" Padding="16,5" Margin="5,0,0,0" BorderThickness="0"/>
                <Button Grid.Column="7" Content="Очистити" Command="{Binding ClearFiltersCommand}" Background="Transparent" Foreground="#333333" FontSize="16" FontWeight="DemiBold" Padding="16,5" Margin="5,0,0,0" BorderThickness="0"/>
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#FF5E5E" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FFFFE0" CornerRadius="6" Padding="18,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Найчастіше грали: " FontSize="18" Foreground="#444444" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MostPlayedGame}" FontSize="19" FontWeight="Normal" Foreground="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FFFFE0" CornerRadius="6" Padding="18,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Найрідше грали: " FontSize="18" Foreground="#444444" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LeastPlayedGame}" FontSize="19" FontWeight="Normal" Foreground="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Background="#C8CAFF" CornerRadius="6" Padding="20,12" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Номер" FontSize="20" Foreground="Black"/>
                    <TextBlock Grid.Column="1" Text="Назва" FontSize="20" Foreground="Black"/>
                    <TextBlock Grid.Column="2" Text="Кількість гравців" FontSize="20" Foreground="Black"/>
                    <TextBlock Grid.Column="3" Text="Зіграно" FontSize="20" Foreground="Black" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Стан" FontSize="20" Foreground="Black" HorizontalAlignment="Center" Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="GamesList" ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#C8CAFF" CornerRadius="6" Margin="0,5" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Number}" FontSize="22" Foreground="Black"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="22" Foreground="Black"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PlayersCount}" FontSize="22" Foreground="Black"/>
                                    <TextBlock Grid.Column="3" Text="{Binding MatchesCount}" FontSize="22" Foreground="Black" HorizontalAlignment="Center"/>

                                    <CheckBox Grid.Column="4" IsChecked="{Binding IsActive, Mode=OneWay}" Visibility="{Binding DataContext.IsAdminMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.ToggleGameStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <Menu Grid.Column="5" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <MenuItem Header="⋮"
                                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Foreground="White"
                                                  FontSize="28"
                                                  Padding="0"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                            <MenuItem Header="Переглянути деталі"
                                                      Command="{Binding Tag.ViewGameDetailsCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                      CommandParameter="{Binding}"
                                                      Foreground="Black" FontSize="16" FontWeight="DemiBold" MinWidth="200" Padding="10,6"/>
                                            <MenuItem Header="Переглянути шаблони"
                                                      Command="{Binding Tag.ViewGameTemplatesCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                      CommandParameter="{Binding}"
                                                      Foreground="Black" FontSize="16" FontWeight="DemiBold" MinWidth="200" Padding="10,6"/>
                                            <MenuItem Header="Видалити"
                                                      Command="{Binding Tag.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding Tag.IsAdminMode, RelativeSource={RelativeSource AncestorType=MenuItem}, Converter={StaticResource BoolToVis}}"
                                                      Foreground="Black" FontSize="16" FontWeight="DemiBold" MinWidth="200" Padding="10,6"/>
                                            <MenuItem Header="Редагувати деталі"
                                                      Command="{Binding Tag.EditGameCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding Tag.IsAdminMode, RelativeSource={RelativeSource AncestorType=MenuItem}, Converter={StaticResource BoolToVis}}"
                                                      Foreground="Black" FontSize="16" FontWeight="DemiBold" MinWidth="200" Padding="10,6"/>
                                            <MenuItem Header="Переглянути статистику"
                                                Command="{Binding Tag.ViewGameStatisticsCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                CommandParameter="{Binding}"
                                                Foreground="Black" FontSize="16" FontWeight="DemiBold" MinWidth="200" Padding="10,6"/>

                                        
                                        </MenuItem>
                                    </Menu>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="5" Text="Ігор не знайдено" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" FontSize="22" Foreground="Black" Panel.ZIndex="1">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=GamesList}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasItems, ElementName=GamesList}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Background="#66000000" Panel.ZIndex="10" Visibility="{Binding IsDetailsPopupOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFE0" MinWidth="400" MaxWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <StackPanel Margin="0">
                    <TextBlock Text="{Binding PopupGameName}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding PopupGameDescription}" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30"/>
                    <TextBlock Text="{Binding PopupGamePlayers, StringFormat='Кількість гравців: {0}'}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <Button Content="Закрити" Command="{Binding ClosePopupCommand}" Background="#FF5E5E" Foreground="White" FontSize="18" Padding="30,10" BorderThickness="0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="#66000000" Panel.ZIndex="10" Visibility="{Binding IsTemplatesPopupOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFE0" MinWidth="450" MaxWidth="900" MaxHeight="650" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Шаблони оцінювання" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <ItemsControl ItemsSource="{Binding PopupTemplates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="340" Background="#C4C5FF" Margin="10" Padding="15" CornerRadius="6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding TemplateName}"
                                                               FontSize="20"
                                                               FontWeight="DemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"/>

                                                    <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <MenuItem Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  Visibility="{Binding DataContext.IsAdminMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                                  Padding="5,0"
                                                                  Background="Transparent"
                                                                  BorderThickness="0">
                                                            <MenuItem.Header>
                                                                <TextBlock Text="⋮"
                                                                           Foreground="#7A7A7A"
                                                                           FontSize="24"
                                                                           FontWeight="Bold"/>
                                                            </MenuItem.Header>
                                                            <MenuItem Header="Редагувати шаблон"
                                                                      Command="{Binding Tag.EditScoreTemplateCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                                      CommandParameter="{Binding}"
                                                                      Foreground="Black" FontSize="16" FontWeight="DemiBold" MinWidth="180" Padding="10,6"/>
                                                        </MenuItem>
                                                    </Menu>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Criteria}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name, StringFormat='{}{0}:'}" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                                                <Border Grid.Column="1" Background="White" BorderBrush="#CCC" BorderThickness="1" Height="28"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="+"
                                    Command="{Binding AddScoreTemplateCommand}"
                                    Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"
                                    FontSize="60"
                                    Foreground="#7A7A7A"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="20,0,20,0"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"/>

                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Закрити" Command="{Binding ClosePopupCommand}" Background="#FF5E5E" Foreground="White" FontSize="18" Padding="30,10" BorderThickness="0" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>