<Window x:Class="Boardy.WPF.Dialogs.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Підтвердження" Height="200" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <!-- Тінь і заокруглені кути для краси -->
    <Border Background="White" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="Заголовок" FontSize="18" FontWeight="Bold" Grid.Row="0"/>

            <TextBlock x:Name="MessageText" Text="Текст повідомлення" TextWrapping="Wrap" 
                       FontSize="14" Margin="0,15,0,0" Grid.Row="1"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2">
                <Button Content="Ні" Width="80" Height="30" Margin="0,0,10,0" 
                        Background="#FFF0F0F0" BorderThickness="0" Click="BtnNo_Click"/>
                <Button Content="Так" Width="80" Height="30" 
                        Background="#FFD9534F" Foreground="White" BorderThickness="0" Click="BtnYes_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>