<UserControl x:Class="Boardy.WPF.Player.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Button Content="Додати гравця"
                    Command="{Binding NavigateToCreatePlayerCommand}"
                    Background="#FF8A80"
                    Foreground="White"
                    FontSize="28"
                    FontWeight="DemiBold"
                    Padding="10,10"
                    BorderThickness="0"
                    HorizontalAlignment="Left"/>

            <TextBlock Text="Усі гравці"
                       FontSize="42"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button Content="Назад"
                    Command="{Binding GoBackCommand}"
                    Background="#FF5E5E"
                    Foreground="White"
                    FontSize="20"
                    Padding="20,8"
                    BorderThickness="0"
                    HorizontalAlignment="Right"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="#FF5E5E"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,10"/>

        <Border Grid.Row="2" Background="#C8CAFF" CornerRadius="6" Padding="20,12" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="45"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Номер" FontSize="20" Foreground="Black"/>
                <TextBlock Grid.Column="1" Text="Ім'я" FontSize="20" Foreground="Black"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding Players}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#C8CAFF" CornerRadius="6" Margin="0,5" Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Number}" FontSize="22" Foreground="Black"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="22" Foreground="Black"/>
                                <Menu Grid.Column="2"
                                      Background="Transparent"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <MenuItem Header="⋮"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Foreground="White"
                                              FontSize="28"
                                              Padding="0"
                                              Background="Transparent"
                                              BorderThickness="0">
                                        <MenuItem Header="Редагувати"
                                                  Command="{Binding Tag.NavigateToEditPlayerCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                  CommandParameter="{Binding}"
                                                  Foreground="Black"
                                                  FontSize="16"
                                                  FontWeight="DemiBold"
                                                  MinWidth="130"
                                                  Padding="10,6"/>
                                        <MenuItem Header="Видалити"
                                                  Command="{Binding Tag.DeletePlayerCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                  CommandParameter="{Binding}"
                                                  Foreground="Black"
                                                  FontSize="16"
                                                  FontWeight="DemiBold"
                                                  MinWidth="130"
                                                  Padding="10,6"/>
                                    </MenuItem>
                                </Menu>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
