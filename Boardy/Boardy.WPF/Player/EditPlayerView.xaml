<UserControl x:Class="Boardy.WPF.Player.EditPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#9597FF">

    <Grid>
        <Button Content="Назад"
                Command="{Binding GoBackCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="15"
                Padding="20,10"
                Background="#FF5E5E"
                Foreground="White"
                FontSize="18"
                BorderThickness="0"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Редагувати гравця"
                       Foreground="Black"
                       FontSize="42"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Border Background="#C8CAFF" Padding="40,30" MinWidth="450">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Ім'я:" 
                                   Foreground="Black"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>

                        <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220"
                                 Height="35"
                                 FontSize="18"
                                 Padding="5,4"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="Gray"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FF5E5E"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Button Content="Зберегти"
                            Command="{Binding SavePlayerCommand}"
                            Background="#FF5E5E"
                            Foreground="White"
                            FontSize="20"
                            Padding="0,10"
                            Width="200"
                            HorizontalAlignment="Center"
                            BorderThickness="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
