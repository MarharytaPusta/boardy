<Window x:Class="Boardy.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:home="clr-namespace:Boardy.WPF.Home"
        xmlns:auth="clr-namespace:Boardy.WPF.Authentication"
        Title="Boardy" Height="600" Width="800" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type home:HomeViewModel}">
            <home:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type auth:AdminLoginViewModel}">
            <auth:AdminLoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type auth:AdminChangePasswordViewModel}">
            <auth:AdminChangePasswordView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>