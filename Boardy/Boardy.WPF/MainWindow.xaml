<Window x:Class="Boardy.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:home="clr-namespace:Boardy.WPF.Home"
        xmlns:auth="clr-namespace:Boardy.WPF.Authentication"
        xmlns:player="clr-namespace:Boardy.WPF.Player"
        xmlns:gameCatalog="clr-namespace:Boardy.WPF.GameCatalog"
        Title="Boardy" Height="700" Width="900" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type home:HomeViewModel}">
            <home:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type auth:AdminLoginViewModel}">
            <auth:AdminLoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type auth:AdminChangePasswordViewModel}">
            <auth:AdminChangePasswordView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type player:CreatePlayerViewModel}">
            <player:CreatePlayerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type player:PlayersViewModel}">
            <player:PlayersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type player:EditPlayerViewModel}">
            <player:EditPlayerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type gameCatalog:CreateGameViewModel}">
            <gameCatalog:CreateGameView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type gameCatalog:GameCatalogViewModel}">
            <gameCatalog:GameCatalogView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
